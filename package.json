{
  "name": "whyfightree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3D burn-severity map of a forest area, rendered with three.js",
  "license": "MIT",
  "author": "Shubin123 <44554264+Shubin123@users.noreply.github.com>",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "template": "vite-node scripts/make-template.ts",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
